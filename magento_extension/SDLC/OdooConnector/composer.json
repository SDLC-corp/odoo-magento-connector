{
    "name": "sdlc/module-odoo-connector",
    "description": "Free companion module of the SDLC Odoo Magento 2 connector: pushes signed change notifications (ids only) to Odoo in near real time.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "SDLC Corp"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "ext-curl": "*",
        "ext-json": "*",
        "magento/framework": "^103.0",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-customer": "*",
        "magento/module-sales": "*"
    },
    "suggest": {
        "magento/module-inventory-api": "Multi-Source Inventory: source item saves are pushed as stock events too."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SDLC\\OdooConnector\\": ""
        }
    }
}
