<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="sdlc_magento_connector.MagentoConsole">
  <div class="mg-console">

    <!-- 1. Masthead -->
    <header class="mg-masthead">
      <div class="mg-masthead__id">
        <img class="mg-masthead__mark" src="/sdlc_magento_connector/static/src/img/magento_mark.svg" alt=""/>
        <div class="mg-masthead__text">
          <h1 class="mg-masthead__title">Magento Console</h1>
          <ul class="mg-conn" t-if="this.data and this.scopedInstances.length" aria-label="Connection status">
            <li t-foreach="this.scopedInstances" t-as="inst" t-key="inst.id"
                t-attf-class="mg-conn__item mg-conn__item--{{ this.connectionTone(inst) }}"
                t-att-title="inst.message or inst.state_label">
              <i class="mg-conn__dot" aria-hidden="true"/>
              <span class="mg-conn__name" t-esc="inst.name"/>
              <span class="mg-conn__state" t-esc="inst.state_label"/>
              <span class="mg-conn__sync" t-att-title="this.lastSyncTitle(inst)" t-esc="this.lastSync(inst)"/>
              <button t-if="inst.open_issues" type="button" class="mg-conn__issues"
                      t-att-title="'Open the Error Center for ' + inst.name"
                      t-on-click="() =&gt; this.open(inst.issues_drill)">
                <i class="oi" data-icon="error" aria-hidden="true"/>
                <t t-esc="this.issuesLabel(inst)"/>
              </button>
            </li>
          </ul>
          <p t-else="" class="mg-masthead__sub">Magento 2 orders, catalog and sync health</p>
        </div>
      </div>
      <div class="mg-masthead__actions">
        <button t-if="this.data and this.data.instances.length" type="button" class="mg-digest"
                t-att-class="{'mg-digest--none': !this.data.last_digest}"
                t-att-title="this.lastDigestTitle"
                t-att-disabled="!this.data.last_digest"
                t-on-click="() =&gt; this.open(this.data.last_digest and this.data.last_digest.drill)">
          <i class="oi" data-icon="mail" aria-hidden="true"/>
          <span t-esc="this.lastDigestLabel"/>
        </button>
        <button type="button" class="mg-btn" t-on-click="() =&gt; this.load()" t-att-disabled="this.state.loading">
          <i class="oi" data-icon="refresh" t-att-class="{'mg-btn__spin': this.state.loading}" aria-hidden="true"/>
          <t t-if="this.state.loading">Refreshing</t>
          <t t-else="">Refresh</t>
        </button>
      </div>
    </header>

    <!-- 2. Grouped nav pills -->
    <nav class="mg-nav" t-if="this.state.navLinks.length" aria-label="Go to">
      <div t-foreach="this.state.navLinks" t-as="grp" t-key="grp.group" class="mg-nav__group">
        <span class="mg-nav__heading" t-esc="grp.group"/>
        <div class="mg-nav__row">
          <button type="button" t-foreach="grp.links" t-as="link" t-key="link.xml_id"
                  class="mg-nav__btn" t-att-title="link.hint"
                  t-on-click="() =&gt; this.openAction(link.xml_id)">
            <i class="oi" t-att-data-icon="link.icon" aria-hidden="true"/>
            <span t-esc="link.label"/>
          </button>
        </div>
      </div>
    </nav>

    <!-- 3 + 4. Filters -->
    <div class="mg-filters" t-if="this.data and this.data.instances.length">
      <div class="mg-chips" role="group" aria-label="Filter by Magento instance">
        <span class="mg-chips__label">Instance</span>
        <button type="button" class="mg-chip"
                t-att-class="{'mg-chip--active': !this.state.selectedIds.length}"
                t-att-aria-pressed="this.state.selectedIds.length ? 'false' : 'true'"
                t-on-click="() =&gt; this.clearInstances()">
          All
          <span class="mg-chip__count" t-esc="this.data.instances.length"/>
        </button>
        <button type="button" t-foreach="this.data.instances" t-as="inst" t-key="inst.id"
                class="mg-chip"
                t-att-class="{'mg-chip--active': this.isSelected(inst.id)}"
                t-att-aria-pressed="this.isSelected(inst.id) ? 'true' : 'false'"
                t-att-title="this.data.company_count &gt; 1 ? inst.company : inst.state_label"
                t-on-click="() =&gt; this.toggleInstance(inst.id)">
          <img t-if="inst.has_logo" class="mg-chip__logo"
               t-attf-src="/web/image/magento.instance/{{ inst.id }}/logo" alt=""/>
          <i t-else="" class="mg-chip__dot" aria-hidden="true"
             t-attf-style="background: {{ this.dotColor(inst.id) }}"/>
          <span t-esc="inst.name"/>
          <i t-if="inst.state === 'error'" class="mg-chip__flag" title="Connection error" aria-label="Connection error"/>
        </button>
      </div>

      <div class="mg-chips" role="group" aria-label="Period">
        <span class="mg-chips__label">Period</span>
        <button type="button" t-foreach="this.data.periods" t-as="days" t-key="days"
                class="mg-chip mg-chip--compact"
                t-att-class="{'mg-chip--active': this.state.days === days}"
                t-att-aria-pressed="this.state.days === days ? 'true' : 'false'"
                t-on-click="() =&gt; this.setPeriod(days)">
          <t t-esc="days"/> days
        </button>
      </div>
    </div>

    <!-- 5. Notices -->
    <div t-if="this.state.error" class="mg-notice mg-notice--error" role="alert">
      <strong>Console unavailable.</strong>
      <span t-esc="this.state.error"/>
    </div>

    <div t-elif="this.state.loading and !this.data" class="mg-notice" role="status">Loading Magento figures…</div>

    <t t-elif="this.data">
      <div t-if="!this.data.instances.length" class="mg-notice mg-notice--warn">
        <strong t-if="this.data.instances_elsewhere">No Magento instance in the companies you have open.</strong>
        <strong t-else="">No Magento instance yet.</strong>
        <span t-if="this.data.instances_elsewhere">
          <t t-esc="this.data.instances_elsewhere"/> instance(s) belong to other companies. Switch company from the top bar to see them.
        </span>
        <span t-else="">Connect a Magento 2 store to start importing orders, products and customers.</span>
        <button type="button" class="mg-link"
                t-on-click="() =&gt; this.openAction('sdlc_magento_connector.action_magento_instance')">Open instances</button>
      </div>

      <t t-else="">
        <div t-if="this.data.orders_hidden" class="mg-notice mg-notice--warn">
          <strong>Order figures are hidden.</strong>
          <span>Your access rights do not include Sales orders, so revenue, order status and countries are not shown.</span>
        </div>

        <!-- 6. KPI rail -->
        <section class="mg-rail" aria-label="Key figures">
          <div t-foreach="this.data.kpis" t-as="kpi" t-key="kpi.key"
               t-attf-class="mg-rail__cell {{ kpi.tone ? 'mg-rail__cell--' + kpi.tone : '' }}"
               role="link" tabindex="0" t-att-title="kpi.hint"
               t-on-click="() =&gt; this.open(kpi.drill)"
               t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, kpi.drill)">
            <span class="mg-rail__label">
              <t t-esc="kpi.label"/>
              <span class="mg-rail__note" t-if="kpi.note" t-esc="kpi.note"/>
            </span>
            <span class="mg-rail__value" t-esc="this.figure(kpi)"/>
          </div>
        </section>

        <!-- 7. Panels -->
        <div class="mg-grid" t-att-class="{'mg-grid--single': this.data.orders_hidden}">

          <section class="mg-panel mg-panel--chart" t-if="!this.data.orders_hidden">
            <div class="mg-panel__head">
              <h2 class="mg-panel__title">Revenue &amp; orders</h2>
              <p class="mg-panel__hint">
                <t t-esc="this.periodLabel"/> · <t t-esc="this.data.currency.name"/>
              </p>
            </div>
            <p t-if="!this.hasOrders" class="mg-empty">No Magento orders dated in this period.</p>
            <div t-else="" class="mg-chart">
              <canvas t-ref="this.trendCanvas" role="img" aria-label="Daily revenue and order count"/>
            </div>
          </section>

          <section class="mg-panel">
            <div class="mg-panel__head">
              <h2 class="mg-panel__title">Needs action</h2>
              <p class="mg-panel__hint" t-if="this.data.attention.length">
                <t t-esc="this.data.attention.length"/> open
              </p>
            </div>
            <p t-if="!this.data.attention.length" class="mg-empty mg-empty--ok">
              <i class="oi" data-icon="check" aria-hidden="true"/> Nothing needs attention. Orders and syncs are clean.
            </p>
            <ul t-else="" class="mg-list">
              <li t-foreach="this.data.attention" t-as="item" t-key="item.key"
                  class="mg-list__row" role="link" tabindex="0"
                  t-on-click="() =&gt; this.open(item.drill)"
                  t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, item.drill)">
                <span t-attf-class="mg-pill mg-pill--{{ item.tone }}" t-esc="item.pill"/>
                <span class="mg-list__name">
                  <span t-esc="item.label"/>
                  <small t-esc="item.detail"/>
                </span>
                <span class="mg-num mg-list__count" t-if="item.count" t-esc="this.count(item.count)"/>
                <i t-else="" class="oi mg-list__go" data-icon="chevron_right" aria-hidden="true"/>
              </li>
            </ul>
          </section>

          <div class="mg-flow" t-if="this.data.net_profit or !this.data.orders_hidden or !this.data.issues_hidden">
            <!-- Net profit (period): a panel, the KPI rail is full (see magento_dashboard.py). -->
            <section class="mg-panel mg-panel--profit" t-if="this.data.net_profit">
              <div class="mg-panel__head">
                <h2 class="mg-panel__title">Net profit (period)</h2>
                <p class="mg-panel__hint">
                  <t t-esc="this.periodLabel"/> · <t t-esc="this.data.currency.name"/> · excl. tax
                </p>
              </div>
              <p t-if="!this.data.net_profit.orders" class="mg-empty">No Magento orders dated in this period.</p>
              <t t-else="">
                <div t-attf-class="mg-profit__total {{ this.data.net_profit.tone ? 'mg-profit__total--' + this.data.net_profit.tone : '' }}"
                     role="link" tabindex="0" title="Open the net profit report"
                     t-on-click="() =&gt; this.open(this.data.net_profit.drill)"
                     t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, this.data.net_profit.drill)">
                  <span class="mg-profit__value" t-esc="this.money(this.data.net_profit.net)"/>
                  <span class="mg-profit__meta">
                    <span t-if="this.marginLabel" t-esc="this.marginLabel"/>
                    <span><t t-esc="this.count(this.data.net_profit.orders)"/> orders</span>
                  </span>
                </div>
                <ul class="mg-profit">
                  <li t-foreach="this.data.net_profit.rows" t-as="row" t-key="row.key"
                      class="mg-profit__row" role="link" tabindex="0" t-att-title="row.hint"
                      t-att-class="{'mg-profit__row--minus': row.sign &lt; 0}"
                      t-on-click="() =&gt; this.open(row.drill)"
                      t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, row.drill)">
                    <span class="mg-profit__label" t-esc="row.label"/>
                    <span class="mg-num" t-esc="this.signedMoney(row)"/>
                  </li>
                </ul>
                <button t-if="this.data.net_profit.estimated_orders" type="button" class="mg-profit__note"
                        t-on-click="() =&gt; this.open(this.data.net_profit.estimated_drill)">
                  <i class="oi" data-icon="info" aria-hidden="true"/>
                  Shipping estimated on <t t-esc="this.count(this.data.net_profit.estimated_orders)"/> order(s): no carrier cost known.
                </button>
              </t>
            </section>

            <section class="mg-panel" t-if="!this.data.issues_hidden">
              <div class="mg-panel__head">
                <h2 class="mg-panel__title">Error center by entity</h2>
                <p class="mg-panel__hint">Open issues</p>
              </div>
              <p t-if="!this.data.by_entity.length" class="mg-empty mg-empty--ok">
                <i class="oi" data-icon="check" aria-hidden="true"/> No open sync issues.
              </p>
              <ul t-else="" class="mg-bars">
                <li t-foreach="this.data.by_entity" t-as="row" t-key="row.key"
                    t-attf-class="mg-bars__row mg-bars__row--{{ row.tone }}" role="link" tabindex="0"
                    t-att-title="this.entityDetail(row)"
                    t-on-click="() =&gt; this.open(row.drill)"
                    t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, row.drill)">
                  <span class="mg-bars__label">
                    <t t-esc="row.label"/><small t-esc="this.entityTag(row)"/>
                  </span>
                  <span class="mg-bars__track">
                    <span t-attf-class="mg-bars__fill mg-bars__fill--{{ row.tone }}"
                          t-attf-style="width: {{ this.share(row.count, this.data.by_entity, 'count') }}%"/>
                  </span>
                  <span class="mg-num" t-esc="this.count(row.count)"/>
                </li>
              </ul>
            </section>

            <t t-if="!this.data.orders_hidden">
            <section class="mg-panel">
              <div class="mg-panel__head">
                <h2 class="mg-panel__title">Order status</h2>
                <p class="mg-panel__hint">Magento status · orders</p>
              </div>
              <p t-if="!this.data.by_status.length" class="mg-empty">No orders in this period.</p>
              <ul t-else="" class="mg-bars">
                <li t-foreach="this.data.by_status" t-as="row" t-key="row.key"
                    class="mg-bars__row" role="link" tabindex="0"
                    t-on-click="() =&gt; this.open(row.drill)"
                    t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, row.drill)">
                  <span class="mg-bars__label" t-esc="row.label"/>
                  <span class="mg-bars__track">
                    <span class="mg-bars__fill mg-bars__fill--alt"
                          t-attf-style="width: {{ this.share(row.count, this.data.by_status, 'count') }}%"/>
                  </span>
                  <span class="mg-num" t-esc="this.count(row.count)"/>
                </li>
              </ul>
            </section>

            <section class="mg-panel">
              <div class="mg-panel__head">
                <h2 class="mg-panel__title">Top categories</h2>
                <p class="mg-panel__hint">Line revenue · <t t-esc="this.data.currency.name"/></p>
              </div>
              <p t-if="!this.data.by_category.length" class="mg-empty">
                No order lines linked to Magento categories in this period.
              </p>
              <ul t-else="" class="mg-bars">
                <li t-foreach="this.data.by_category" t-as="row" t-key="row.id"
                    class="mg-bars__row" role="link" tabindex="0"
                    t-on-click="() =&gt; this.open(row.drill)"
                    t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, row.drill)">
                  <span class="mg-bars__label" t-att-title="row.name" t-esc="row.name"/>
                  <span class="mg-bars__track">
                    <span class="mg-bars__fill"
                          t-attf-style="width: {{ this.share(row.revenue, this.data.by_category, 'revenue') }}%"/>
                  </span>
                  <span class="mg-num" t-esc="this.money(row.revenue)"/>
                </li>
              </ul>
            </section>

            <section class="mg-panel">
              <div class="mg-panel__head">
                <h2 class="mg-panel__title">Top countries</h2>
                <p class="mg-panel__hint">Shipping country · <t t-esc="this.data.currency.name"/></p>
              </div>
              <p t-if="!this.data.by_country.length" class="mg-empty">No shipped-to countries in this period.</p>
              <ul t-else="" class="mg-bars">
                <li t-foreach="this.data.by_country" t-as="row" t-key="row.id"
                    class="mg-bars__row" role="link" tabindex="0"
                    t-on-click="() =&gt; this.open(row.drill)"
                    t-on-keydown="(ev) =&gt; this.onKeyOpen(ev, row.drill)">
                  <span class="mg-bars__label" t-att-title="row.name">
                    <t t-esc="row.name"/><small><t t-esc="this.count(row.orders)"/> orders</small>
                  </span>
                  <span class="mg-bars__track">
                    <span class="mg-bars__fill"
                          t-attf-style="width: {{ this.share(row.revenue, this.data.by_country, 'revenue') }}%"/>
                  </span>
                  <span class="mg-num" t-esc="this.money(row.revenue)"/>
                </li>
              </ul>
            </section>
            </t>
          </div>
        </div>
      </t>
    </t>
  </div>
</t>

</templates>
