<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_magento_field_mapping_search" model="ir.ui.view">
            <field name="name">magento.field.mapping.search</field>
            <field name="model">magento.field.mapping</field>
            <field name="arch" type="xml">
                <search string="Magento Field Mapping">
                    <field name="mapping_type"/>
                    <field name="instance_id"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                </search>
            </field>
        </record>

        <record id="action_magento_field_mapping_test_all" model="ir.actions.server">
            <field name="name">Test Mapping</field>
            <field name="model_id" ref="model_magento_field_mapping"/>
            <field name="state">code</field>
            <field name="code">
action = env['magento.field.mapping'].with_context(
    active_domain=env.context.get('domain') or env.context.get('active_domain')
).action_test_mapping()
            </field>
        </record>

        <record id="action_magento_field_mapping" model="ir.actions.act_window">
            <field name="name">Magento Field Mapping</field>
            <field name="res_model">magento.field.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_magento_field_mapping_search"/>
        </record>

        <record id="action_magento_field_mapping_product" model="ir.actions.act_window">
            <field name="name">Product Mapping</field>
            <field name="res_model">magento.field.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_magento_field_mapping_search"/>
            <field name="domain">[('mapping_type', '=', 'product')]</field>
            <field name="context">{'default_mapping_type': 'product'}</field>
        </record>

        <record id="action_magento_field_mapping_customer" model="ir.actions.act_window">
            <field name="name">Customer Mapping</field>
            <field name="res_model">magento.field.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_magento_field_mapping_search"/>
            <field name="domain">[('mapping_type', '=', 'customer')]</field>
            <field name="context">{'default_mapping_type': 'customer'}</field>
        </record>

        <record id="action_magento_field_mapping_category" model="ir.actions.act_window">
            <field name="name">Category Mapping</field>
            <field name="res_model">magento.field.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_magento_field_mapping_search"/>
            <field name="domain">[('mapping_type', '=', 'category')]</field>
            <field name="context">{'default_mapping_type': 'category'}</field>
        </record>

        <record id="view_magento_mapping_report_search" model="ir.ui.view">
            <field name="name">magento.mapping.report.search</field>
            <field name="model">magento.mapping.report</field>
            <field name="arch" type="xml">
                <search string="Magento Mapping Report">
                    <field name="instance_id"/>
                    <field name="mapping_type"/>
                    <field name="direction"/>
                    <field name="source_action"/>
                    <field name="status"/>
                    <field name="record_name"/>
                    <filter name="status_success" string="Success" domain="[('status', '=', 'success')]"/>
                    <filter name="status_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                </search>
            </field>
        </record>

        <record id="view_magento_mapping_report_list" model="ir.ui.view">
            <field name="name">magento.mapping.report.list</field>
            <field name="model">magento.mapping.report</field>
            <field name="arch" type="xml">
                <list string="Magento Mapping Report" create="0" edit="0" delete="0" import="0">
                    <field name="instance_id"/>
                    <field name="mapping_type"/>
                    <field name="direction"/>
                    <field name="source_action"/>
                    <field name="status"/>
                    <field name="record_name"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="view_magento_mapping_report_form" model="ir.ui.view">
            <field name="name">magento.mapping.report.form</field>
            <field name="model">magento.mapping.report</field>
            <field name="arch" type="xml">
                <form string="Magento Mapping Report" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="instance_id" readonly="1"/>
                            <field name="mapping_type" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="source_action" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="record_name" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Changes">
                                <field name="line_ids" nolabel="1" readonly="1">
                                    <list create="0" import="0" delete="0">
                                        <field name="scope"/>
                                        <field name="odoo_field"/>
                                        <field name="magento_field"/>
                                        <field name="old_value"/>
                                        <field name="new_value"/>
                                        <field name="applied"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Payload">
                                <group>
                                    <field name="payload_text" readonly="1" widget="text"/>
                                    <field name="notes" readonly="1" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_magento_mapping_report" model="ir.actions.act_window">
            <field name="name">Mapping Report</field>
            <field name="res_model">magento.mapping.report</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="search_view_id" ref="view_magento_mapping_report_search"/>
            <field name="views" eval="[(ref('view_magento_mapping_report_list'), 'list'), (ref('view_magento_mapping_report_form'), 'form')]"/>
        </record>

        <record id="view_magento_field_mapping_list" model="ir.ui.view">
            <field name="name">magento.field.mapping.list</field>
            <field name="model">magento.field.mapping</field>
            <field name="arch" type="xml">
                <list string="Magento Field Mapping" editable="bottom">
                    <header>
                        <button name="%(action_magento_field_mapping_test_all)d"
                                type="action"
                                string="Test"
                                class="btn-secondary me-2"
                                display="always"/>
                        <button name="action_sync_magento_fields"
                                type="object"
                                string="Load New Fields"
                                class="btn-success"
                                display="always"/>
                    </header>
                    <field name="mapping_type" readonly="1"/>
                    <field name="instance_id"/>
                    <field name="odoo_field" domain="[('model_id', '=', odoo_model_id)]"/>
                    <field name="magento_field_id"
                           domain="[('instance_id', '=', instance_id), ('mapping_type', '=', mapping_type)]"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_magento_field_mapping_form" model="ir.ui.view">
            <field name="name">magento.field.mapping.form</field>
            <field name="model">magento.field.mapping</field>
            <field name="arch" type="xml">
                <form string="Magento Field Mapping">
                    <header>
                        <button name="action_test_mapping"
                                type="object"
                                string="Test Mapping"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="mapping_type" readonly="1"/>
                            <field name="instance_id"/>
                            <field name="odoo_field"
                                   required="1"
                                   domain="[('model_id', '=', odoo_model_id)]"
                                   options="{'no_create': True}"/>
                            <field name="magento_field_id"
                                   required="1"
                                   domain="[('instance_id', '=', instance_id), ('mapping_type', '=', mapping_type)]"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_sync_magento_fields"
                                type="object"
                                string="Load New Fields"
                                class="btn-success me-2"/>
                        <button name="action_test_mapping"
                                type="object"
                                string="Test Mapping"
                                class="btn-primary"/>
                        <button special="cancel" string="Close" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
