    <odoo>
        <data>
        <record id="view_magento_instance_list" model="ir.ui.view">
            <field name="name">magento.instance.list</field>
            <field name="model">magento.instance</field>
            <field name="arch" type="xml">
                <list string="Magento Instances" import="0">
                    <field name="name" />
                    <field name="base_url" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="view_magento_instance_form" model="ir.ui.view">
            <field name="name">magento.instance.form</field>
            <field name="model">magento.instance</field>
            <field name="arch" type="xml">
                <form string="Magento Instance">
                    <header>
                        <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary" />
                        <button name="action_sync_products" type="object" string="Sync Products" />
                        <button name="action_sync_categories" type="object" string="Sync Categories" />
                        <button name="action_sync_customers" type="object" string="Sync Customers" />
                        <button name="action_sync_orders" type="object" string="Sync Orders" />
                        <button name="action_sync_attribute_sets" type="object"
                            string="Sync Attribute Sets" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="base_url" />
                                <field name="access_token" />
                                <field name="website_id" />
                                <field name="store_id" />
                                <field name="store_code" />
                                <field name="customer_default_password" password="True" />
                                <field name="verify_ssl" />
                                <field name="active" />
                            </group>
                            <group string="Payment Sync">
                                <field name="auto_register_magento_payment" />
                                <field name="update_magento_status_on_paid" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Auto Sync Cron">
                                <group>
                                    <group>
                                        <field name="auto_sync_enabled" />
                                        <field name="auto_sync_frequency"
                                            invisible="not auto_sync_enabled"
                                            required="auto_sync_enabled" />
                                        <field name="auto_sync_hour_interval"
                                            invisible="not auto_sync_enabled or auto_sync_frequency != 'hourly'" />
                                        <field name="auto_sync_hour"
                                            invisible="not auto_sync_enabled or auto_sync_frequency == 'hourly'" />
                                        <field name="auto_sync_minute"
                                            invisible="not auto_sync_enabled or auto_sync_frequency == 'hourly'" />
                                        <field name="auto_sync_weekly_date"
                                            widget="date"
                                            invisible="not auto_sync_enabled or auto_sync_frequency != 'weekly'" />
                                        <field name="auto_sync_monthly_date"
                                            widget="date"
                                            invisible="not auto_sync_enabled or auto_sync_frequency != 'monthly'" />
                                        <field name="auto_sync_cron_id" readonly="1"
                                            invisible="not auto_sync_enabled" />
                                    </group>
                                    <group string="Auto Sync Scope (Select one or more)"
                                        invisible="not auto_sync_enabled">
                                        <field name="auto_sync_products" />
                                        <field name="auto_sync_customers" />
                                        <field name="auto_sync_categories" />
                                        <field name="auto_sync_orders" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

