        <record id="action_magento_cancelled_orders_report" model="ir.actions.act_window">
            <field name="name">Cancelled Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_sale_order_tree_magento_cancelled_report"/>
            <field name="domain">
                [
                    '&amp;',
                    ('magento_order_id', '!=', False),
                    '|', '|',
                    ('state', '=', 'cancel'),
                    ('magento_status', 'ilike', 'canceled'),
                    ('magento_status', 'ilike', 'cancelled')
                ]
            </field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="views" eval="[(ref('view_sale_order_tree_magento_cancelled_report'), 'list')]"/>
        </record>

