<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_magento" model="ir.ui.view">
        <field name="name">sale.order.form.magento</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="is_magento_order" invisible="1"/>
            </xpath>

            <xpath expr="//form/header" position="inside">
                <button name="action_create_magento_order"
                        type="object"
                        string="Create in Magento"
                        class="oe_highlight"
                        groups="sdlc_magento_connector.group_magento_user"
                        invisible="magento_order_id"/>
                <button name="action_pull_magento_order"
                        type="object"
                        string="Pull from Magento"
                        class="btn-secondary"
                        groups="sdlc_magento_connector.group_magento_user"
                        invisible="not magento_order_id"/>
                <button name="action_update_magento_order"
                        type="object"
                        string="Update in Magento"
                        class="btn-secondary"
                        groups="sdlc_magento_connector.group_magento_user"
                        invisible="not magento_order_id"/>
            </xpath>

            <!-- Conflict: Magento changed an order that is no longer a draft in Odoo. -->
            <xpath expr="//form/sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Magento conflict" bg_color="text-bg-danger"
                        invisible="not magento_sync_conflict"/>
            </xpath>
            <xpath expr="//form/sheet/div[hasclass('oe_title')]" position="before">
                <div class="alert alert-danger" role="alert" invisible="not magento_sync_conflict">
                    <strong>Magento conflict.</strong>
                    Magento changed this order after it left draft in Odoo, so the Odoo lines were not overwritten.
                    Review the differences below, then correct the order manually.
                    <field name="magento_conflict_note" nolabel="1" readonly="1" class="d-block mt-1"/>
                </div>
            </xpath>

            <xpath expr="//form/sheet/group" position="after">
                <group string="Magento" name="magento_info" invisible="not is_magento_order">
                    <group>
                        <field name="magento_instance_id"/>
                        <field name="magento_order_id" readonly="1"/>
                        <field name="magento_increment_id" readonly="1"/>
                        <field name="magento_status" readonly="1"/>
                        <field name="magento_customer_email"/>
                        <field name="magento_sync_conflict" readonly="1"/>
                    </group>
                    <group>
                        <field name="magento_invoice_state" readonly="1"/>
                        <field name="magento_total_invoiced" readonly="1"/>
                        <field name="magento_payment_state" readonly="1"/>
                        <field name="magento_total_paid" readonly="1"/>
                        <field name="magento_currency" readonly="1"/>
                        <field name="magento_created_at" readonly="1"/>
                        <field name="magento_updated_at" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_magento_invoice_button" model="ir.ui.view">
        <field name="name">sale.order.form.magento.invoice.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or magento_invoice_state in ('partial','invoiced')</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or magento_invoice_state in ('partial','invoiced')</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_tree_magento_instance" model="ir.ui.view">
        <field name="name">sale.order.tree.magento.instance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="magento_instance_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_tree_magento_only" model="ir.ui.view">
        <field name="name">sale.order.tree.magento.only</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <list string="Magento Orders" import="0" decoration-danger="magento_sync_conflict">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="magento_increment_id"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="magento_order_id" optional="hide"/>
                <field name="magento_instance_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="magento_status" widget="badge" optional="show"
                       decoration-success="magento_status == 'complete'"
                       decoration-info="magento_status in ('processing', 'pending')"
                       decoration-warning="magento_status in ('holded', 'payment_review', 'pending_payment')"
                       decoration-danger="magento_status in ('canceled', 'closed', 'fraud')"/>
                <field name="magento_invoice_state" widget="badge" optional="show"
                       decoration-success="magento_invoice_state == 'invoiced'"
                       decoration-warning="magento_invoice_state == 'partial'"/>
                <field name="magento_payment_state" widget="badge" optional="show"
                       decoration-success="magento_payment_state == 'paid'"
                       decoration-warning="magento_payment_state == 'partial'"/>
                <field name="delivery_status" widget="badge" optional="show"
                       decoration-success="delivery_status == 'full'"
                       decoration-warning="delivery_status in ('partial', 'started')"/>
                <field name="magento_total_invoiced" sum="Total invoiced" optional="hide"/>
                <field name="magento_total_paid" sum="Total paid" optional="hide"/>
                <field name="amount_total" sum="Total" decoration-bf="1"/>
                <field name="magento_sync_conflict" string="Conflict" widget="boolean" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_tree_magento_cancelled_report" model="ir.ui.view">
        <field name="name">sale.order.tree.magento.cancelled.report</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Magento Cancelled Orders" create="0" edit="0" delete="0" import="0">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="date_order"/>
                <field name="magento_increment_id"/>
                <field name="magento_order_id" optional="hide"/>
                <field name="magento_instance_id" optional="show"/>
                <field name="magento_status" widget="badge" decoration-danger="1"/>
                <field name="magento_customer_email" optional="show"/>
                <field name="magento_payment_state" widget="badge" optional="show"
                       decoration-success="magento_payment_state == 'paid'"
                       decoration-warning="magento_payment_state == 'partial'"/>
                <field name="amount_total" sum="Total" optional="show"/>
                <field name="state" widget="badge" optional="show"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Search for the Magento order actions (primary: does not change the Sales app search). -->
    <record id="view_sale_order_search_magento" model="ir.ui.view">
        <field name="name">sale.order.search.magento</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="magento_increment_id"/>
                <field name="magento_order_id"/>
                <field name="magento_customer_email"/>
                <field name="magento_instance_id"/>
            </xpath>
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="magento_conflict" string="Magento conflict"
                        domain="[('magento_sync_conflict', '=', True)]"/>
                <separator/>
                <filter name="magento_not_paid" string="Not paid in Magento"
                        domain="[('magento_payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="magento_not_invoiced" string="Not invoiced in Magento"
                        domain="[('magento_invoice_state', 'in', ('not_invoiced', 'partial'))]"/>
                <separator/>
                <filter name="magento_order_date" string="Order Date" date="date_order"/>
            </filter>
            <xpath expr="//group" position="inside">
                <filter name="group_magento_instance" string="Magento Instance"
                        context="{'group_by': 'magento_instance_id'}"/>
                <filter name="group_magento_status" string="Magento Status"
                        context="{'group_by': 'magento_status'}"/>
                <filter name="group_magento_payment_state" string="Magento Payment Status"
                        context="{'group_by': 'magento_payment_state'}"/>
                <filter name="group_company" string="Company"
                        context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
