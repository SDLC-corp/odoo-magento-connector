<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Phase 3 (3.3): real-time push from the free SDLC_OdooConnector
         Magento module. Standard views only (house style: odoo-trs-ui).
         ============================================================ -->

    <!-- Pushed events -->
    <record id="view_magento_webhook_event_list" model="ir.ui.view">
        <field name="name">magento.webhook.event.list</field>
        <field name="model">magento.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Real-time Events" create="0" edit="0"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'ignored'">
                <field name="received_at"/>
                <field name="entity"/>
                <field name="event_type" optional="show"/>
                <field name="magento_id" optional="hide"/>
                <field name="magento_ref"/>
                <field name="occurred_at" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'queued'"
                       decoration-danger="state == 'rejected'"/>
                <field name="job_id" optional="show"/>
                <field name="job_state" widget="badge" optional="show"
                       decoration-info="job_state in ('pending', 'started')"
                       decoration-success="job_state == 'done'"
                       decoration-danger="job_state == 'failed'"/>
                <field name="note" optional="show"/>
                <field name="return_to_stock_items" optional="hide"/>
                <field name="event_uid" optional="hide"/>
                <field name="delivery_id" optional="hide"/>
                <field name="instance_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_magento_webhook_event_form" model="ir.ui.view">
        <field name="name">magento.webhook.event.form</field>
        <field name="model">magento.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Real-time Event" create="0" edit="0">
                <header>
                    <button name="action_open_job" type="object" string="Open Job"
                            invisible="not job_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Event">
                            <field name="instance_id"/>
                            <field name="entity"/>
                            <field name="event_type"/>
                            <field name="magento_id"/>
                            <field name="magento_ref"/>
                            <field name="note" invisible="not note"/>
                            <field name="return_to_stock_items" invisible="entity != 'creditmemo'"/>
                        </group>
                        <group string="Delivery">
                            <field name="occurred_at"/>
                            <field name="received_at"/>
                            <field name="event_uid"/>
                            <field name="delivery_id"/>
                            <field name="job_id"/>
                            <field name="job_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_magento_webhook_event_search" model="ir.ui.view">
        <field name="name">magento.webhook.event.search</field>
        <field name="model">magento.webhook.event</field>
        <field name="arch" type="xml">
            <search string="Real-time Events">
                <field name="magento_ref"/>
                <field name="event_uid"/>
                <field name="instance_id"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="ignored" string="Ignored" domain="[('state', '=', 'ignored')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="job_failed" string="Job Failed" domain="[('job_state', '=', 'failed')]"/>
                <group>
                    <filter name="group_entity" string="Entity" context="{'group_by': 'entity'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_magento_webhook_event" model="ir.actions.act_window">
        <field name="name">Real-time Events</field>
        <field name="res_model">magento.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No real-time event received yet</p>
            <p>Install the free SDLC_OdooConnector module in Magento and paste the webhook URL
               and shared secret from the instance's <b>Real-time</b> tab. Each order, invoice,
               shipment, credit memo, product, customer or stock change then reaches Odoo
               within about a minute. Events are kept a few days.</p>
        </field>
    </record>

    <menuitem id="menu_magento_webhook_event" name="Real-time Events"
              parent="sdlc_magento_connector.menu_magento_reports"
              action="action_magento_webhook_event" sequence="6"/>

    <!-- Instance: Real-time tab -->
    <record id="view_magento_instance_form_webhook_p3" model="ir.ui.view">
        <field name="name">magento.instance.form.webhook.p3</field>
        <field name="model">magento.instance</field>
        <field name="inherit_id" ref="sdlc_magento_connector.view_magento_instance_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_webhook_events" type="object"
                        class="oe_stat_button" icon="fa-bolt"
                        invisible="not webhook_enabled">
                    <field name="webhook_event_count" widget="statinfo" string="Pushes (24 h)"/>
                </button>
            </div>
            <page name="scheduling" position="after">
                <page string="Real-time" name="magento_realtime">
                    <div class="alert alert-info mb-3" role="status" invisible="webhook_enabled">
                        Magento Open Source has no outgoing webhooks. The free
                        <b>SDLC_OdooConnector</b> Magento module (folder
                        <code>magento_extension/SDLC/OdooConnector</code> of this connector) records
                        each change in an outbox and pushes it here, signed, about once a minute.
                        Scheduled polling keeps running as the safety net.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="webhook_health != 'rejecting'">
                        <strong>Odoo is rejecting pushes.</strong>
                        <field name="last_webhook_rejection" readonly="1" class="d-block"/>
                        Check that the secret and URL in Magento match this tab and that both clocks are on time.
                    </div>
                    <group>
                        <group string="Real-time Push">
                            <field name="webhook_enabled" widget="boolean_toggle"/>
                            <field name="webhook_health" widget="badge" invisible="not webhook_enabled"
                                   decoration-success="webhook_health == 'healthy'"
                                   decoration-warning="webhook_health in ('waiting', 'stale')"
                                   decoration-danger="webhook_health == 'rejecting'"/>
                            <field name="webhook_base_url" invisible="not webhook_enabled"
                                   placeholder="Defaults to web.base.url"/>
                            <field name="webhook_url" widget="CopyClipboardChar"
                                   invisible="not webhook_enabled"/>
                            <field name="webhook_secret" widget="CopyClipboardChar" password="True"
                                   invisible="not webhook_enabled"
                                   groups="sdlc_magento_connector.group_magento_manager"/>
                        </group>
                        <group string="Activity (24 h)" invisible="not webhook_enabled">
                            <field name="last_webhook_at"/>
                            <field name="webhook_event_count" class="o_field_integer"/>
                            <field name="webhook_queued_count" class="o_field_integer"/>
                            <field name="webhook_rejected_count" class="o_field_integer"/>
                            <field name="last_webhook_rejected_at" invisible="not last_webhook_rejected_at"/>
                        </group>
                    </group>
                    <div class="d-flex flex-wrap gap-2 mb-3" invisible="not webhook_enabled"
                         groups="sdlc_magento_connector.group_magento_manager">
                        <button name="action_webhook_regenerate_secret" type="object"
                                string="Regenerate Secret" icon="fa-refresh" class="btn-secondary"
                                confirm="Magento pushes are rejected until the new secret is saved in Magento. Continue?"/>
                        <button name="action_webhook_regenerate_uuid" type="object"
                                string="Regenerate URL" icon="fa-link" class="btn-secondary"
                                confirm="Magento pushes are rejected until the new URL is saved in Magento. Continue?"/>
                        <button name="action_view_webhook_events" type="object"
                                string="All Events" icon="fa-list" class="btn-link"/>
                    </div>
                    <group invisible="not webhook_enabled">
                        <group string="Polling Fallback">
                            <field name="webhook_reduces_polling"/>
                            <field name="webhook_poll_interval_hours"
                                   invisible="not webhook_reduces_polling"/>
                            <field name="webhook_last_poll_at" invisible="not webhook_reduces_polling"/>
                        </group>
                    </group>
                    <separator string="Latest Events" invisible="not webhook_enabled"/>
                    <field name="webhook_recent_event_ids" nolabel="1" readonly="1" invisible="not webhook_enabled">
                        <list decoration-danger="state == 'rejected'"
                              decoration-muted="state == 'ignored'">
                            <field name="received_at"/>
                            <field name="entity"/>
                            <field name="event_type"/>
                            <field name="magento_ref"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'queued'"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="job_state" widget="badge"
                                   decoration-success="job_state == 'done'"
                                   decoration-danger="job_state == 'failed'"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>
                    <separator string="Set Up and Test"/>
                    <ol class="text-muted small ps-3 mb-0">
                        <li>In Magento: <code>composer</code> path repository or copy the module to
                            <code>app/code/SDLC/OdooConnector</code>, then
                            <code>bin/magento module:enable SDLC_OdooConnector &amp;&amp; bin/magento setup:upgrade</code>.</li>
                        <li>Turn on <b>Real-time Push</b> above and save; copy the <b>Webhook URL</b> and
                            <b>Shared Secret</b>.</li>
                        <li>Magento admin: Stores &gt; Configuration &gt; Services &gt; Odoo Connector:
                            Enabled = Yes, paste the URL and secret, choose the events, save.</li>
                        <li>Magento cron must run (<code>bin/magento cron:run</code>, group
                            <code>sdlc_odoo_connector</code>). Test now with
                            <code>bin/magento sdlc:odoo:outbox:flush</code>.</li>
                        <li>Change a product name in Magento: an event appears in <b>Latest Events</b>
                            and its job updates the Odoo product. A wrong secret shows here as a
                            rejected push and Magento retries with backoff.</li>
                    </ol>
                </page>
            </page>
        </field>
    </record>
</odoo>
