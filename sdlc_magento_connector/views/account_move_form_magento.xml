<odoo>

    <record id="view_move_form_magento_inherit" model="ir.ui.view">
        <field name="name">account.move.form.magento</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add smart button near existing stat buttons -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">

                <button name="action_open_magento_credit_memo"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-external-link" attrs="{'invisible': [('magento_credit_memo_id', '=', False)]}">
                    <field name="magento_credit_memo_display" widget="statinfo" string="Credit Memo"/>
                </button>

            </xpath>


            <!-- Add Magento Information tab -->
            <xpath expr="//notebook" position="inside">

                <page string="Magento" attrs="{'invisible': [('magento_sale_order_id', '=', False)]}">
                    <field name="magento_sale_order_id" invisible="1"/>

                    <group string="Order Information" col="4">
                        <field name="magento_sale_order_name" readonly="1"/>
                        <field name="magento_sale_order_created_at" readonly="1"/>
                        <field name="magento_invoice_id" readonly="1"/>
                        <field name="magento_credit_memo_id" readonly="1"/>
                    </group>

                    <group string="Credit Memo Information" col="4">
                        <field name="magento_credit_memo_display" readonly="1"/>
                        <field name="magento_credit_memo_created_at" readonly="1"/>
                        <field name="magento_refund_state" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="magento_refunded_amount"
                               widget="monetary"
                               options="{'currency_field':'currency_id'}"
                               readonly="1"/>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

    <!-- Accounting list: show Magento credit memo columns on the standard Invoices/Credit Notes list -->
    <record id="view_invoice_tree_magento_credit_memo_fields" model="ir.ui.view">
        <field name="name">account.invoice.list.magento.credit.memo.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <!-- Hide Odoo "Number" column on Credit Memos; we show Magento Credit Memo instead -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">context.get('default_move_type') == 'out_refund'</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="before">
                <field name="magento_credit_memo_display"
                       string="Credit Memo"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
                <field name="magento_credit_memo_created_at"
                       string="Created"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
                <field name="magento_sale_order_name"
                       string="Order #"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
                <field name="magento_sale_order_created_at"
                       string="Order Date"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
            </xpath>

            <xpath expr="//field[@name='invoice_partner_display_name'][contains(@invisible, 'out_invoice')]"
                   position="attributes">
                <attribute name="string">Bill-to Name</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_partner_display_name'][contains(@invisible, 'out_invoice')]"
                   position="after">
                <field name="magento_refund_state"
                       string="Status"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
                <field name="magento_refunded_amount"
                       string="Refunded"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"
                       invisible="context.get('default_move_type') != 'out_refund'" />
                <field name="magento_credit_memo_id" invisible="1"/>
                <button name="action_open_magento_credit_memo"
                        type="object"
                        string="View"
                        class="btn-link"
                        invisible="context.get('default_move_type') != 'out_refund'" attrs="{'invisible': [('magento_credit_memo_id', '=', False)]}" />
            </xpath>

            <!-- Hide standard invoice columns on Credit Memos (out_refund) to match Magento UI -->
            <xpath expr="//field[@name='invoice_date'][contains(@invisible, 'out_invoice')]"
                   position="attributes">
                <attribute name="invisible">context.get('default_move_type') == 'out_refund' or context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="invisible">context.get('default_move_type') == 'out_refund'</attribute>
            </xpath>

            <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
                <attribute name="invisible">context.get('default_move_type') == 'out_refund'</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_state']" position="attributes">
                <attribute name="invisible">context.get('default_move_type') == 'out_refund'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
