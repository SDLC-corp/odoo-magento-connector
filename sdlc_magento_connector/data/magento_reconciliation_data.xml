<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Nightly order reconciliation for every active instance with "Reconcile Orders Daily".
      Ships inactive so upgrading does not start hitting Magento; noupdate keeps an
      administrator's activation and schedule across upgrades.
    -->
    <data noupdate="1">
        <record id="ir_cron_magento_reconcile_daily" model="ir.cron">
            <field name="name">Magento: Reconcile Orders (daily)</field>
            <field name="model_id" ref="model_magento_reconciliation"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_yesterday()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
