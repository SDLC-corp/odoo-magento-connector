<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: an administrator's interval/activation survives upgrades. -->
    <data noupdate="1">
        <!-- Polls accepted async bulk operations; idle (no Magento calls) when none is open. -->
        <record id="ir_cron_magento_bulk_poll" model="ir.cron">
            <field name="name">Magento: Poll Bulk Operations</field>
            <field name="model_id" ref="model_magento_bulk_operation"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_bulk_operations()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
