<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: an administrator's interval/activation survives upgrades. -->
    <data noupdate="1">
        <!-- Nightly full stock reconcile. Inactive by default; only instances with
             "Automatic Stock Push" on are pushed (one queued job per instance). -->
        <record id="ir_cron_magento_stock_reconcile" model="ir.cron">
            <field name="name">Magento: Nightly Stock Reconcile</field>
            <field name="model_id" ref="model_magento_instance"/>
            <field name="state">code</field>
            <field name="code">model._cron_magento_stock_reconcile()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
