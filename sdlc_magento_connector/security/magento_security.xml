<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_magento" model="ir.module.category">
        <field name="name">Magento Connector</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_magento" model="res.groups.privilege">
        <field name="name">Magento</field>
        <field name="category_id" ref="module_category_magento"/>
    </record>

    <!--
        Runs syncs and works the records; cannot see credentials or change instances.
        Order/invoice/shipment syncs create sale orders, invoices and pickings, and the
        Operations menus open those models, so the operator also needs the standard
        Sales (all documents), Inventory user and Invoicing rights.
    -->
    <record id="group_magento_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_magento"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice')),
        ]"/>
    </record>

    <!-- Configures instances, credentials, mappings and schedules. -->
    <record id="group_magento_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_magento"/>
        <field name="implied_ids" eval="[(4, ref('group_magento_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!--
        Multi-company record rules. Global (no groups) so they bind every user,
        managers included; a user only sees Magento data of the companies
        currently selected in the company switcher.
    -->
    <record id="rule_magento_instance_company" model="ir.rule">
        <field name="name">Magento instance: multi-company</field>
        <field name="model_id" ref="model_magento_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

