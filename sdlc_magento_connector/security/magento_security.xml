<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_magento" model="ir.module.category">
        <field name="name">Magento Connector</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_magento" model="res.groups.privilege">
        <field name="name">Magento</field>
        <field name="category_id" ref="module_category_magento"/>
    </record>

    <!-- Runs syncs and works the records; cannot see credentials or change instances. -->
    <record id="group_magento_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_magento"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Configures instances, credentials, mappings and schedules. -->
    <record id="group_magento_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_magento"/>
        <field name="implied_ids" eval="[(4, ref('group_magento_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
